<a href="{{ product.url }}">
  {%- if product.featured_image -%}
    <img src="{{ product.featured_image | image_url: width: 480 }}" alt="{{ product.featured_image.alt | escape }}" width="480" loading="lazy">
  {%- endif -%}
  <span>{{ product.title }}</span>
  <span>{{ product.price | money }}</span>
</a>
