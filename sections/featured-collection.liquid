<div class="page-width">
  <h2>{{ section.settings.title }}</h2>
  <ul class="product-grid">
    {%- for product in section.settings.collection.products limit: section.settings.limit -%}
      <li>{% render 'product-card', product: product %}</li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Featured" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
