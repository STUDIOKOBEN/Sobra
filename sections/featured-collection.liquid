{%- assign products = section.settings.collection.products -%}
{%- if section.settings.collection == blank -%}
  {%- assign products = collections.all.products -%}
{%- endif -%}

{% render 'catalogue-filter' %}

<div class="grid product-grid">
  {%- for product in products limit: section.settings.limit -%}
    <div class="cell" data-tags="{{ product.tags | join: ',' | downcase | escape }}">
      {% render 'product-card', product: product %}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 48, "step": 4, "default": 24 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
